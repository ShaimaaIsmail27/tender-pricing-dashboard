    <bpmn:exclusiveGateway id="G_Teilnahme" name="Teilnahme sinnvoll?"><bpmn:incoming>F02</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing><bpmn:outgoing>F04</bpmn:outgoing></bpmn:exclusiveGateway>
