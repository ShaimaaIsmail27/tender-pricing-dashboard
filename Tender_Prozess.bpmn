    <bpmn:exclusiveGateway id="G_MergeA"><bpmn:incoming>F05</bpmn:incoming><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F06</bpmn:outgoing></bpmn:exclusiveGateway>
